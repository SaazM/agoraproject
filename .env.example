VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only. Needed by the admin API routes (api/admin/*): delete student, regrade tests.
# Local `vite dev` serves those routes too, so set it here to use them locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
